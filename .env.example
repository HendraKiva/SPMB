# Salin file ini menjadi .env untuk pengembangan lokal.
# Saat deploy ke Render, isi nilai-nilai ini di menu "Environment" (bukan file .env).

# Connection string dari MongoDB Atlas, contoh:
# mongodb+srv://namauser:password@cluster0.xxxxx.mongodb.net/spmb-abu-hurairah?retryWrites=true&w=majority
MONGO_URI=

# Kata sandi untuk login admin di aplikasi (bebas Anda tentukan, gunakan yang kuat)
ADMIN_PASSWORD=

# String acak untuk menandatangani token login admin (boleh string panjang bebas)
JWT_SECRET=

# Port server (Render akan mengisi otomatis, boleh dikosongkan saat deploy)
PORT=3000
